# APEX Environment Configuration
# Copy this file to `.env` and fill in your keys.

# =========================================================
# OPENROUTER AI CONFIGURATION
# Used by the Desktop Relay Server for the `Socratic Challenger` 
# and `Peer Radar` logic generation.
# Get a key from: https://openrouter.ai/keys
# =========================================================
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# =========================================================
# GROQ AI CONFIGURATION (Optional Alternative)
# If using Groq's high-speed inference for Llama 3.3.
# =========================================================
GROQ_API_KEY=gsk_your_groq_key_here

# =========================================================
# DATABASE & BACKEND (Optional if running full distributed stack)
# =========================================================
DATABASE_URL=sqlite+aiosqlite:///./apex_dev.db
JWT_SECRET_KEY=generate-a-secure-random-key
