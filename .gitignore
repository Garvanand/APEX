# APEX Project Git Ignore Rules

# Operating System Files
.DS_Store
Thumbs.db
*.db
*.log
.env

# IDE & Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Python (Backend) build and virtual environment outputs
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
ENV/
backend/.env
backend/venv/

# Node (Desktop UI) build and package outputs
node_modules/
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter (Mobile) build and SDK outputs
.dart_tool/
.packages
.pub-cache/
.pub/
mobile/.dart_tool/
mobile/.packages
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/.symlinks/
mobile/ios/Pods/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
